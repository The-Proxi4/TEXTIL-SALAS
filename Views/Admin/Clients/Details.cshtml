@model textil_salas.ViewModels.ClientViewModel

@{
    ViewData["Title"] = "Detalle cliente";
}

<h2>Detalle cliente</h2>

<dl class="row">
    <dt class="col-sm-2">Nombre</dt><dd class="col-sm-10">@Model.NombreCompleto</dd>
    <dt class="col-sm-2">Email</dt><dd class="col-sm-10">@Model.Email</dd>
    <dt class="col-sm-2">Teléfono</dt><dd class="col-sm-10">@Model.PhoneNumber</dd>
    <dt class="col-sm-2">Estado</dt><dd class="col-sm-10">@(Model.IsActive ? "Activo" : "Inactivo")</dd>
    <dt class="col-sm-2">Desactivado</dt><dd class="col-sm-10">@(Model.DeactivatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</dd>
</dl>

<a asp-action="Index" class="btn btn-secondary">Volver</a>
