@model textil_salas.ViewModels.ClientViewModel

@{
    ViewData["Title"] = "Detalle cliente";
}

<div class="container">
    <div class="card">
        <div class="card-body">
            <h2 class="card-title">Detalle cliente</h2>
            <div class="row">
                <div class="col-md-6">
                    <h5>Información</h5>
                    <p><strong>Nombre:</strong> @Model.NombreCompleto</p>
                    <p><strong>Email:</strong> @Model.Email</p>
                    <p><strong>Teléfono:</strong> @Model.PhoneNumber</p>
                </div>
                <div class="col-md-6">
                    <h5>Estado</h5>
                    <p>@(Model.IsActive ? "Activo" : "Inactivo")</p>
                    <p><strong>Desactivado:</strong> @(Model.DeactivatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</p>
                </div>
            </div>
            <div class="mt-3">
                <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary ms-2">Editar</a>
            </div>
        </div>
    </div>
</div>
